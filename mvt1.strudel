setcps(120/120);

// m7-8 piccolo solo
let m7_8 = note("<[g7 c8 g7 c8] g7@1.5 ~@0.5 f7 g7 c8@3>")
    .s("gm_flute");

// m9-13 french horn solo
let m9_13 = note("<d4 a4@2.75 ~@0.25 g4 c5@3 d4 a4@2.5 a4@0.5 g4 e4@3>")
    .s("gm_french_horn");

// m13-18
let m13_18 = stack(
    note("<~@14.5 [g5 f5]@0.5 g5 c6 [b6 c6]@0.5 b6@3.5>")
        .s("gm_flute"),
    note("<~@14.5 [g5 f5]@0.5 g5 c5 [b5 c5]@0.5 b5@0.5>")
        .s("gm_clarinet"),
    note("<~@18 b3 g3@2>")
        .s("gm_alto_sax"),
    note("<~ c3@4 bb3@4 g2@4 g2@4 ~ f#3 g3@2>")
        .s("gm_tenor_sax"),
    note("<~ eb2@2 c2@2 bb2@4 ab2@4 g2@4 g2@4>")
        .s("gm_baritone_sax"),
    note("<[d4 bf3] c4 g4@3 f4 bf3@3 g4@3.5 [g4 f4]@0.5 g4@4 b2@4>")
        .s("gm_trumpet"),
    note("<~@17 g3@4>")
        .s("gm_trumpet"),
    note("<~ c3@4 f3@4 c3@4 d3@4  ~ b3 g3@2>")
        .s("gm_french_horn"),
    note("<~ c3@4 bb2@4 c3@4 c3@4 d2@4>")
        .s("gm_euphonium"),
    note("<~ c3@4 bb2@4 f2@4 f2@4 d2@4>")
        .s("gm_french_horn"), //euph lb 1
    note("<~ g2@4 f2@4 eb2@4 d2@4 b2@4>")
        .s("gm_trombone"),
    note("<~ c1@2 c2@2 bb2@4 ab2@4 g2@4 g2@4>")
        .s("gm_tuba"),
    note("<~@17 g0@4>")
        .s("gm_tuba"),
);

//m18-22
let m18_22 = stack(
    note("<c5 g5@3 bb5@2 g6 f6 eb6@3.5 [f5 g5]@0.5 a5 f5 c6@2>")
        .s("gm_flute"),
    note("<c5 g5@3 bb5@2 g5 f5 eb5@3.5 [f5 g5]@0.5 a5 f5 c5@2>")
        .s("gm_clarinet"),
    note("<c5 g4@3 bb4@2 g4 f4 eb4@3.5 [f4 g4]@0.5 a4 f4 c5@2>")
        .s("gm_clarinet"),
    note("<c3 g3@3 bb3@2 g3 f3 eb3@3.5 [f3 g3]@0.5 a3 f3 c3@2>")
        .s("gm_alto_sax"),
    note("<c2 g2@3 bb2@3 bb2 eb2@2 ab2 [bb2 c3] f2@2.5 f2@0.5 [f2 f2 f2 f2]>")
        .s("gm_tenor_sax"),
    note("<c3@1.75 c3@0.25 c3 [ab2 g2] f2@3 f2 ab2@3 [ab2 g2 f#2] f2@3 [g2 bb2]>")
        .s("gm_baritone_sax"),
    note("<g4@1.75 g4@0.25 g4@2 bb4@3 bb4 c5@2 eb5@2 c5@2 f5@2>")
        .s("gm_trumpet"),
    note("<eb4@1.75 eb4@0.25 eb4@2 g4@3 g4 ab4@2 c5@2 a4@2 c5@2>")
        .s("gm_trumpet"),
    note("<c4 g3@3 bb3@2 g3 f3 eb3@3.5 [f3 g3]@0.5 a3 f3 c4@2>")
        .s("gm_french_horn"),
    note("<eb2@1.75 eb2@0.25 eb2@2 eb2@3 bb2 c3@2 ab2 [bb2 c3] c3@2.5 c3@0.5 [c3 c3 c3 c3]>")
        .s("gm_french_horn"), //euph lb 1
    note("<eb2@1.75 eb2@0.25 eb2@2 bb2@3 bb2 c3@2 ab2 [bb2 c3] c3@2.5 c3@0.5 [c3 c3 c3 c3]>")
        .s("gm_french_horn"), //euph lb 1
    note("<g2@1.75 g2@0.25 g2@2 g2@3 g2 eb2@2 ab2 [bb2 c3] a2@2.5 a2@0.5 [a2 a2 a2 a2]>")
        .s("gm_trombone"),
    note("<c3@1.75 c3@0.25 c3 [g3 f3] eb3@3 eb3 ab3@3 [ab3 g3 f#3]f3@3 [g3 bb3]>")
        .s("gm_tuba"),
);


arrange(
    [7, m7_8],
    [16, m9_13],
    [21, m13_18],
    [16, m18_22]
);