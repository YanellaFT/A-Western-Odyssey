setcps(220/120)

let mA = stack(
    note("<g5@1.5 a5@1.5 bb5@1.5 c6@0.5 [g5 a5 bb5 c6] d6@6 [bb5 bb5 bb5]@2 [c6 c6 c6]@2>")
        .s("gm_piccolo"),
        // .gain("<0.6@12 2.2@4>")
    note("<g4@1.5 a4@1.5 bb4@1.5 c5@0.5 [g4 a4 bb4 c5] d5@6 [bb4 bb4 bb4]@2 [c5 c5 c5]@2>")
        .s("gm_clarinet"),
    note("<g3@1.5 a3@1.5 bb3@9 [d4 d4 d4]@2 [g4 g4 g4]@2>")
        .s("gm_alto_sax"),
    note("<g2@1.5 g2@10.5 [c3 c3 c3]@2 [d3 d3 d3]@2>")
        .s("gm_tenor_sax"),
    note("<g2@3 g2@3 g2@3 d2@3 ~@4>")
        .s("gm_baritone_sax"),
    note("<g4@1.5 a4@1.5 bb4@1.5 c4@7.5 [d4 d4 d4]@2 [g4 g4 g4]@2>")
        .s("gm_trumpet"),
    note("<g3@1.5 a3@1.5 bb3@9 [c4 c4 c4]@2 [d4 d4 d4]@2>")
        .s("gm_trumpet"),
    note("<g3@1.5 a3@1.5 bb3@9 [g3 g3 g3]@2 [a3 a3 a3]@2>")
        .s("gm_french_horn"),
    note("<g3@1.5 a3@10.5 [a3 a3 a3]@2 [bb3 bb3 bb3]@2>")
        .s("gm_french_horn"), // lb 1 supposed to be euphonium
    note("<g3@1.5 a3@10.5 [bb3 bb3 bb3]@2 [c4 c4 c4]@2>")
        .s("gm_french_horn"), // lb 1 supposed to be euponium
    note("<g3@1.5 g3@10.5 [g3 g3 g3]@2 [a3 a3 a3]@2>")
        .s("gm_trombone"),
    note("<g2@3 g2@3 g2@3 d2@3 ~@4>")
        .s("gm_tuba")
).gain("<0.6@12 1.0@4>");

let mB = stack(
    note("<~@4 [d6 d6] [d6 d6] [d6 d6] [d6 eb6 f6 f#6] g6@0.5 ~@7.5>")
        .s("gm_flute"),
    note("<~@4 [eb6 eb6] [eb6 eb6] [eb6 eb6] [d6 eb6 f6 f#6] g6@0.5 ~@7.5>")
        .s("gm_flute"),
    note("<~@4 [d5 d5] [d5 d5] [d5 d5] [d5 eb5 f5 f#5] g5@0.5 ~@7.5>")
        .s("gm_clarinet"),
    note("<~@4 [e5 e5] [e5 e5] [e5 e5] [d5 eb5 f5 f#5] g5@0.5 ~@7.5>")
        .s("gm_clarinet"),
    note("< ~@4 ab3 bb3 c4 [d4 eb4 f4 f#4] g4@0.5 ~@7.5>")
        .s("gm_alto_sax"),
    note("<~ d3@3 a3 a3 a3 [d3 eb3 f3 f#3] g3@0.5 ~@7.5>")
        .s("gm_tenor_sax"),
    note("<~ d2@3 d2 d2 d2 [d2 eb2 f2 f#2] g2@0.5 ~@7.5>")
        .s("gm_baritone_sax"),
    note("<~@4 [eb4 eb4] [eb4 eb4] [eb4 eb4] [d4 eb4 f4 f#4] g4@0.5 ~@7.5>")
        .s("gm_trumpet"),
    note("<~@4  [d4 d4] [d4 d4] [d4 d4] [d3 eb3 f3 f#3] g3@0.5 ~@7.5>")
        .s("gm_trumpet"),
    note("<~@4 a3 b3 c4 [d4 e4 f4 f#4] g4@0.5 ~@7.5>")
        .s("gm_french_horn"),
    note("<~ d3@3 d4 d4 d4 [d4 eb4 f4 f#4] g4@0.5 ~@7.5>")
        .s("gm_french_horn"), // lb1 eup
    note("<~ d3@3 a3 a3 a3 [d3 eb3 f3 f#3] g3@0.5 ~@7.5>")
        .s("gm_trombone"),
    note("<~ d2@3 d2 d2 d2 [d2 eb2 f2 f#2] g2@0.5 ~@7.5>")
        .s("gm_tuba")
    
).gain("<0.7@4 1.3@5 1@7>");

arrange(
    [16, mA],
    [16, mB],

);