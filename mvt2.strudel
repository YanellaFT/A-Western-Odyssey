    note("<~@4 [b5 bb5 a5 ab5] [g5 f#5 f5 e5] [eb5 d5 db5 c5] [b4 bb4 a4 ab4] ~@2 [b4 eb5 f#5] [f5 a5 c6] b5@0.5 ~@4.5 [b4 c5 c#5 d5] [d#5 e5 f5 f#5] [g5 ab5 a5 bb5] b5@0.5 ~@3.5 f#5@2 b5@2>")
        .s("gm_alto_sax").transpose(-9),
    note("<~@4 [b4 bb4 a4 ab4] [g4 f#4 f4 e4] [eb4 d4 db4 c4] [b3 bb3 a3 ab3] ~@2 [b3 eb4 f#4] [f4 a4 c5] b4@0.5 ~@4.5 [b3 c4 c#4 d4] [d#4 e4 f4 f#4] [g4 ab4 a4 bb4] b4@0.5 ~@3.5 f#4@2 b4@2>")
        .s("gm_tenor_sax").transpose(-9),
