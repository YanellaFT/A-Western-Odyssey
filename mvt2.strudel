        .s("gm_trumpet"),
    note("<~@24 d4@4>")
        .s("gm_trumpet"),
    note("<~@12 [f#3 f#3 f#3]@2 [ab3 ab3 ab3]@2 ~@8 a3@4>")
        .s("gm_trumpet"),
    note("<~@12 [e3 e3 e3]@2 [g3 g3 g3]@2 ~@8 e4@2 a4@2>")
